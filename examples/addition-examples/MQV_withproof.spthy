                          case isend_case_1
                          solve( !KU( dhExp(P'g', Fei) ) @ #vk.4 )
                            case coerce
                            solve( !KD( dhExp(P'g', Fei) ) ▶₀ #vk.3 )
                              case Using_OutFacts_case_1
                              by contradiction /* cyclic */
                            next
                              case Using_OutFacts_case_2
