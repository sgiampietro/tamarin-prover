lemma secrecyB:
  all-traces
  "∀ Gm A B #i.
    ((Secret( B, A, Gm ) @ #i) ∧ (¬(∃ #l. Compromised( A ) @ #l))) ⇒
    (¬(∃ #j. K( Gm ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ Gm A B #i.
  (Secret( B, A, Gm ) @ #i)
 ∧
  (∀ #l. (Compromised( A ) @ #l) ⇒ ⊥) ∧ (∃ #j. (K( Gm ) @ #j))"
*/
by sorry

lemma secrecyA:
  all-traces
  "∀ Gm A B #i.
    ((ReceivedA( A, B, Gm ) @ #i) ∧ (¬(∃ #l. Compromised( A ) @ #l))) ⇒
    (¬(∃ #k. K( Gm ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ Gm A B #i.
  (ReceivedA( A, B, Gm ) @ #i)
 ∧
  (∀ #l. (Compromised( A ) @ #l) ⇒ ⊥) ∧ (∃ #k. (K( Gm ) @ #k))"
*/
by sorry







