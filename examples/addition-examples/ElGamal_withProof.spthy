theory ElGamal begin

// Function signature and definition of the equational theory E

builtins: DH-multiplication
functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2







rule (modulo E) GenKey:
   [ FrDH( Fx ) ]
  -->
   [
   !SKey( $B, Fx ), !PubKey( $B, dhExp(P'g', Fx) ),
   Out( dhExp(P'g', Fx) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) RevealKey:
   [ !SKey( $Y, Fx ) ] --[ Compromised( $Y ) ]-> [ Out( Fx ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) BobEncrypts:
   [ !PubKey( $A, dhExp(P'g', Esa) ), FrDH( Fy ), FrDH( Fm ) ]
  --[
  Secret( $B, $A, dhExp(P'g', Fm) ),
  BobSent( $B, $A, dhExp(P'g', Fm) )
  ]->
   [
   Out( <$B, dhExp(P'g', Fy)> ),
   Out( dhMult(dhExp(P'g', Fm), dhExp(dhExp(P'g', Esa), Fy)) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) AliceReceives:
   [
   !SKey( $A, Fska ), In( <$B, dhExp(P'g', Ec1)> ),
   In( dhExp(P'g', Ec2) )
   ]
  --[
  ReceivedA( $A, $B,
             dhMult(dhExp(P'g', Ec2), dhGinv(dhExp(dhExp(P'g', Ec1), Fska)))
  )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma executable:
  exists-trace
  "∃ Gm A B #i #j.
    ((BobSent( B, A, Gm ) @ #i) ∧ (ReceivedA( A, B, Gm ) @ #j)) ∧
    (¬(∃ #l X. Compromised( X ) @ #l))"
/*
guarded formula characterizing all satisfying traces:
"∃ Gm A B #i #j.
  (BobSent( B, A, Gm ) @ #i) ∧ (ReceivedA( A, B, Gm ) @ #j)
 ∧
  ∀ #l X. (Compromised( X ) @ #l) ⇒ ⊥"
*/
simplify
solve( BobSent( B, A, Gm ) @ #i )
  case BobEncrypts
  solve( !PubKey( $A, dhExp(P'g', Esa) ) ▶₀ #i )
    case GenKey
    solve( ReceivedA( $A, $B, dhExp(P'g', Fm) ) @ #j )
      case AliceReceives_case_1
      by sorry /* removed */
    next
      case AliceReceives_case_2
      by sorry /* removed */
    next
      case AliceReceives_case_3
      solve( !SKey( $A, Fska ) ▶₀ #j )
        case GenKey_case_1
        solve( !KU( dhMult(dhExp(P'g', Fm),
                           dhExp(P'g', dhTimesE(Evy, Fska)))
               ) @ #vk.3 )
          case coerce
          solve( !KD( dhMult(dhExp(P'g', Fm),
                             dhExp(P'g', dhTimesE(Evy, Fska)))
                 ) ▶₀ #vk )
            case Using_OutFacts_case_01
            by contradiction /* from formulas */
          next
            case Using_OutFacts_case_02
            by sorry
          next
            case Using_OutFacts_case_03
            solve( !KU( dhExp(P'g', Fy) ) @ #vk.3 )
              case coerce
              solve( !KD( dhExp(P'g', Fy) ) ▶₀ #vk.1 )
                case Using_OutFacts_case_1
                SOLVED // trace found
              next
                case Using_OutFacts_case_2
                by sorry
              next
                case Using_OutFacts_case_3
                by contradiction /* from formulas */
              qed
            qed
          next
            case Using_OutFacts_case_04
            by contradiction /* from formulas */
          next
            case Using_OutFacts_case_05
            by contradiction /* from formulas */
          next
            case Using_OutFacts_case_06
            by contradiction /* from formulas */
          next
