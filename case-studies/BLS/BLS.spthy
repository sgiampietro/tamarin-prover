theory BLS
begin


/* ----------------- */
/* Equational theory */
/* ----------------- */

/* Load the built-in symmetrical encryption theory */
builtins: DH-multiplication

/* -------------- */
/* Protocol rules */
/* -------------- */

rule GenKey:  // share a key pair between two parties.
   [ FrDH(Fx) ] 
   --[  ]->
   [ !SKey($A, Fx), !PubKey($A, dhExp(P'g2', Fx)),
     Out(dhExp(P'g2', Fx)) ]

rule SignMessage:
  [!SKey($I, Fski), FrDH(Fx)]
  --[ Signed($I, Fx) ]->
  [Out(<$I, Fx, dhExp(dhExp(P'g1', dhH(Fx)), Fski)>)]

rule VerifyMessage:
  [!PubKey($I, dhExp(P'g2', Eki) ), In(<$I, Emess, dhExp(P'g1',Esign)>)]
  --[ Eq( dhBP(dhExp(P'g1',dhH(Emess)), dhExp(P'g2', Eki)), dhBP(dhExp(P'g1', Esign), P'g2') ), Verified(Emess, $I, dhExp(P'g1',Esign))]->
  [ Done(Emess, $I, dhExp(P'g1',Esign)) ]


restriction equality: 
"All x y #i. Eq(x,y)@i ==> x = y"


lemma executable:
exists-trace
"Ex I Gs Em #i #j. Verified(Em, I, Gs)@i & Signed(I, Em)@j"

lemma unforgeable:
"All I Gs Em #i. Verified(Em, I, Gs)@i ==> Ex #j. Signed(I, Em)@j"

end



