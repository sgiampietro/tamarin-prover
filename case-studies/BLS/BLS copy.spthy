theory MQV
begin


/* ----------------- */
/* Equational theory */
/* ----------------- */

/* Load the built-in symmetrical encryption theory */
builtins: DH-multiplication

/* -------------- */
/* Protocol rules */
/* -------------- */

rule GenKey:  // share a key pair between two parties.
   [ FrDH(Fx) ] 
   --[  ]->
   [ !SKey($A, Fx), !PubKey($A, dhExp(P'g', Fx)),
     Out(dhExp(P'g', Fx)) ]

rule SignMessage:
  [!SKey($I, Fski), Fr(~x)]
  --[ Signed($I, ~x) ]->
  [Out(<$I, ~x, dhExp(dhExp(P'g', ~x), Fski)>)]


rule VerifyMessage:
  [!PubKey($I, Gpki), In(<$I, mess, Gsign>)]
  --[ Eq( dhBP(dhExp(P'g',mess), Gpki), dhBP(Gsign, 'g') ) ]->
  [ Verified(~x, $I, Gsign) ]



lemma executable:
exists-trace
"Ex I Gs m #i #j. Verified(m, I, Gs)@i & Signed(I, m)@j"

lemma unforgeable:
"All I Gs m #i. Verified(m, I Gs)@i ==> Ex #j. Signed(I, m)@j"

end



