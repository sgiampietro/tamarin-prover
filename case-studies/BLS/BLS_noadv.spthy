theory BLS
begin


/* ----------------- */
/* Equational theory */
/* ----------------- */

/* Load the built-in symmetrical encryption theory */
builtins: DH-multiplication

/* -------------- */
/* Protocol rules */
/* -------------- */

rule GenKey:  // share a key pair between two parties.
   [ FrDH(Fx) ] 
   --[  ]->
   [ !SKey($A, Fx), !PubKey($A, dhExp(P'g2', Fx)) ]

rule SignMessage:
  [!SKey($I, Fski), FrDH(Fx)]
  --[ Signed($I, Fx) ]->
  [PrivSend(<$I, Fx, dhExp(dhExp(P'g1', dhMu(dhExp(P'g',Fx))), Fski)>)]

rule VerifyMessage:
  [!PubKey($I, dhExp(P'g2', Fki) ), PrivSend(<$I, Exc, dhExp(P'g1',Esign)>)]
  --[ 
  Eq( dhExp(P'g', dhBP(dhExp(P'g1',dhMu(dhExp(P'g', Exc))), dhExp(P'g2', Fki))), dhExp(P'g',dhBP(dhExp(P'g1', Esign), P'g2')) ), 
  Verified(Exc, $I, dhExp(P'g1',Esign))]->
  [ Done() ]


restriction equality: 
"All x y #i. Eq(x,y)@i ==> x = y"


lemma executable:
exists-trace
"Ex I Gs Em #i #j. Verified(Em, I, Gs)@i & Signed(I, Em)@j"

//lemma unforgeable:
//"All I Gs m #i. Verified(m, I, Gs)@i ==> Ex #j. Signed(I, m)@j"

end



