theory BLS
begin


/* ----------------- */
/* Equational theory */
/* ----------------- */

/* Load the built-in symmetrical encryption theory */
builtins: DH-multiplication

/* -------------- */
/* Protocol rules */
/* -------------- */


rule Generate:
  [FrDH(Fx), FrDH(Fy)]
  --[ Created(Fx, Fy) ]->
  [Out(dhExp(P'g1',Fx)), Out(dhExp(P'g2', Fy)) ]



lemma executable:
exists-trace
"Ex Ey Em #i #j. Created(Em, Ey)@i & K( dhExp(P'g', dhBP(dhExp(P'g1',Ey), dhExp(P'g2', Em))) )@j"


end



